<Window x:Class="AdhDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicroCon ADH Dashboard" Height="300" Width="400" Background="#1e1e1e">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20">
        <TextBlock Text="Hardware Telemetry" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <TextBlock x:Name="DistanceText" Text="Distance: -- cm" Foreground="#4CAF50" FontSize="20" HorizontalAlignment="Center"/>
        
        <!-- מד המרחק הויזואלי -->
        <ProgressBar x:Name="DistanceBar" Minimum="20" Maximum="200" Height="25" Margin="0,10,0,20" Foreground="#4CAF50" Background="#333333" BorderThickness="0"/>
        
        <TextBlock x:Name="AdcText" Text="ADC Value: --" Foreground="#2196F3" FontSize="16" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>